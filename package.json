{
  "name": "ugotmonee",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check-statement": "node scripts/check-statement.mjs",
    "push": "pnpm build && pnpm dlx @google/clasp@3 push -f",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "devDependencies": {
    "@types/google-apps-script": "^2.0.14",
    "@types/node": "^22",
    "esbuild": "0.25",
    "pdfjs-dist": "3.11.174",
    "typescript": "^5",
    "vitest": "3"
  },
  "packageManager": "pnpm@9.15.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
